# ---------------------------------------------------------------------------
# Oura credentials (both modes)
# ---------------------------------------------------------------------------

# Option 1: Personal Access Token (find at https://cloud.ouraring.com/personal-access-tokens)
OURA_PERSONAL_ACCESS_TOKEN=your_personal_access_token

# Option 2: OAuth2 credentials (find at https://cloud.ouraring.com/oauth/applications)
# NOTE: the authorization-code flow against Oura is not implemented yet, so these
# are accepted but will fail at request time. Use the token above.
OURA_CLIENT_ID=your_client_id
OURA_CLIENT_SECRET=your_client_secret
OURA_REDIRECT_URI=http://localhost:3000/callback

# ---------------------------------------------------------------------------
# Hosted mode only (npm start) - required to serve claude.ai and the mobile apps
# ---------------------------------------------------------------------------

# Public https origin of the deployment, no trailing slash.
# On Railway you can leave this unset: it is inferred from the
# RAILWAY_PUBLIC_DOMAIN variable that Railway injects once you generate a domain.
PUBLIC_URL=https://your-app.up.railway.app

# Signs client ids, authorization codes, and tokens. Generate with:
#   openssl rand -hex 32
# Changing this invalidates every issued token and forces a reconnect.
OAUTH_SIGNING_SECRET=your_64_char_hex_secret

# The password you type on the sign-in page when connecting Claude.
MCP_AUTH_PASSWORD=choose_a_strong_password

# Set automatically by Railway; defaults to 3000 locally.
# PORT=3000
